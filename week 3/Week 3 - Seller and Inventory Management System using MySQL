SELECT
s.seller_name,
p.product_name,
p.price,
i.stock_quantity,
i.status
FROM inventory i
JOIN sellers s ON i.seller_id=s.seller_id
JOIN products p ON i.product_id=p.product_id
ORDER BY s.seller_name;
SELECT
p.product_name,
s.seller_name,
i.stock_quantity,
i.status
FROM inventory i
JOIN sellers s ON i.seller_id=s.seller_id
JOIN products p ON i.product_id=p.product_id
ORDER BY i.status;

SELECT
status,
COUNT(*) AS total_products
FROM inventory
GROUP BY status;
